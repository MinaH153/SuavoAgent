<Project>

  <!--
    Shared PE / assembly metadata applied to every SuavoAgent project.
    Company / Product / Copyright / Authors are identical across the fleet.
    AssemblyTitle + Description are set per-project in each .csproj.

    Version defaults to 0.0.0 for local developer builds; the release workflow
    overrides via `-p:Version=<tag-without-v-prefix>` so the signed, shipped
    binaries carry the real release number in their PE header.
  -->

  <PropertyGroup>
    <!--
      Legal entity on CA SOS filing B20260126045 (file date 2026-03-23) is
      MKM TECHNOLOGIES LLC. "Suavo" is a trade name used for the agent product
      but has no DBA/FBN on file yet, so the EV code-signing cert — which is
      vetted against the CA SOS record — will be issued to MKM Technologies LLC.
      Keep Company + Copyright aligned with the cert so the signed binary's
      Properties dialog and the UAC publisher string match the signature.
    -->
    <Company>MKM Technologies LLC</Company>
    <Authors>MKM Technologies LLC</Authors>
    <Product>SuavoAgent</Product>
    <Copyright>© 2026 MKM Technologies LLC</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Trademark>SuavoAgent™ is a trademark of MKM Technologies LLC.</Trademark>

    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!-- A vulnerable transitive dependency is a release failure, not an
         informational restore warning. Audit the full graph and promote every
         NuGet severity to an error so the clean local result cannot regress. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>

    <!-- Every project carries a checked-in, transitive dependency lock. CI
         opts into locked mode so restore cannot silently rewrite the graph. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <RuntimeFrameworkVersion Condition="'$(RuntimeIdentifier)' == 'win-x64'">8.0.28</RuntimeFrameworkVersion>
    <!-- Declaring (not selecting) the sole production RID lets one checked-in
         lock graph cover portable unit-test builds and exact win-x64 publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!-- Do not compiler-PathMap source documents here. Coverlet 6 treats the
         synthetic /_/ tree as non-local and can emit an empty report for an
         otherwise fully exercised assembly. The hardened merger canonicalizes
         Linux and Windows checkout paths to repository-owned src/ identities
         after collection, without changing the PDB source documents that the
         collector needs for instrumentation. -->
  </PropertyGroup>

  <!-- Empty local builds fail closed. Production release workflows must pass
       the reviewed SHA-256 signer-certificate allowlist explicitly. -->
  <ItemGroup>
    <AssemblyMetadata Include="SuavoAuthenticodeSignerSha256"
                      Value="$(AuthenticodeSignerSha256)" />
  </ItemGroup>

</Project>
