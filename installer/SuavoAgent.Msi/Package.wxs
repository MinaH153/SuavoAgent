<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     RequiredVersion="7.0.0">
  <Package Id="MKM.SuavoAgent"
           Name="SuavoAgent"
           Manufacturer="MKM Technologies LLC"
           Version="$(SuavoAgentVersion)"
           ProductCode="*"
           UpgradeCode="{32C06D4D-CFC3-49CB-A6C4-A52E6EFFFBCB}"
           UpgradeStrategy="majorUpgrade"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="SuavoAgent pharmacy workstation agent"
                        Manufacturer="MKM Technologies LLC" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Property Id="ARPCOMMENTS" Value="Native Suavo pharmacy workstation agent" />
    <Property Id="ARPHELPLINK" Value="https://suavollc.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://suavollc.com" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Launch Condition="VersionNT64" Message="SuavoAgent requires 64-bit Windows." />
    <Launch Condition="REMOVE~=&quot;ALL&quot; OR NOT RollbackDisabled"
            Message="SuavoAgent requires Windows Installer rollback to protect the existing service configuration." />

    <!-- Windows Installer's MsiServiceConfig family is documented as not
         working correctly and WiX emits WIX1149 for it. Run the signed,
         installed maintenance host through three fixed non-sensitive modes.
         Apply durably snapshots all three services before ChangeServiceConfig2;
         rollback restores that snapshot after any later MSI failure; commit is
         the only successful-install path that removes the journal. -->
    <CustomAction Id="RollbackServiceHardening"
                  FileRef="MaintenanceExecutable"
                  ExeCommand="--msi-rollback-service-hardening"
                  Execute="rollback"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />
    <CustomAction Id="ApplyServiceHardening"
                  FileRef="MaintenanceExecutable"
                  ExeCommand="--msi-apply-service-hardening"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />
    <CustomAction Id="CommitServiceHardening"
                  FileRef="MaintenanceExecutable"
                  ExeCommand="--msi-commit-service-hardening"
                  Execute="commit"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />
    <!-- Commit-only takeover cleanup: if MSI rolls back this never runs.
         Impersonation intentionally preserves the installing user's profile so
         the exact former Suavo.lnk can be inspected and retired. The native
         host preserves every unclassified same-name shortcut and never deletes
         the developer-publish directory itself. -->
    <CustomAction Id="RetireLegacyInteractiveLaunch"
                  FileRef="MaintenanceExecutable"
                  ExeCommand="--msi-retire-legacy-interactive"
                  Execute="commit"
                  Impersonate="yes"
                  Return="check"
                  HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="RollbackServiceHardening"
              Before="ApplyServiceHardening"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND (NOT Installed OR REINSTALL)" />
      <Custom Action="ApplyServiceHardening"
              After="InstallServices"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND (NOT Installed OR REINSTALL)" />
      <Custom Action="CommitServiceHardening"
              After="ApplyServiceHardening"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND (NOT Installed OR REINSTALL)" />
      <Custom Action="RetireLegacyInteractiveLaunch"
              After="CommitServiceHardening"
              Condition="NOT REMOVE~=&quot;ALL&quot; AND (NOT Installed OR REINSTALL)" />
    </InstallExecuteSequence>

    <Feature Id="Complete" Title="SuavoAgent" Level="1">
      <ComponentGroupRef Id="SuavoAgentComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SUAVOFOLDER" Name="Suavo">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="SuavoAgent">
        <Directory Id="LOGSFOLDER" Name="logs">
          <Directory Id="HELPERLOGFOLDER" Name="helper" />
        </Directory>
        <Directory Id="DIAGNOSTICSFOLDER" Name="diagnostics">
          <Directory Id="HELPERDIAGNOSTICSFOLDER" Name="helper" />
        </Directory>
        <Directory Id="HONEYTOKENFOLDER" Name="honeytokens" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SuavoAgentProgramMenuFolder" Name="SuavoAgent" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="SuavoAgentComponents">
      <ComponentRef Id="InstallDirectoryPermissions" />
      <ComponentRef Id="CoreService" />
      <ComponentRef Id="BrokerService" />
      <ComponentRef Id="WatchdogService" />
      <ComponentRef Id="InteractiveHelper" />
      <ComponentRef Id="NativeMaintenanceHost" />
      <ComponentRef Id="NativeOnboardingEntry" />
      <ComponentRef Id="BootstrapConfiguration" />
      <ComponentRef Id="DataDirectoryPermissions" />
      <ComponentRef Id="IntegrityMetadata" />
      <ComponentRef Id="LegacyInstallCleanup" />
    </ComponentGroup>

    <Component Id="InstallDirectoryPermissions"
               Directory="INSTALLFOLDER"
               Guid="{FE61C8E6-4F08-46E6-B962-A4BAA68AC771}">
      <CreateFolder>
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;;0x1200a9;;;BU)" />
      </CreateFolder>
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
    </Component>

    <Component Id="CoreService"
               Directory="INSTALLFOLDER"
               Guid="{E6B8F2A8-70D6-4D26-B62C-F9398F046824}">
      <File Id="CoreExecutable"
            Name="SuavoAgent.Core.exe"
            Source="$(PayloadRoot)/Core/SuavoAgent.Core.exe"
            KeyPath="yes"
            Vital="yes" />
      <ServiceInstall Id="InstallCoreService"
                      Name="SuavoAgent.Core"
                      DisplayName="SuavoAgent Core"
                      Description="Suavo pharmacy agent - SQL polling and cloud synchronization"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="NT AUTHORITY\LocalService"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
        <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRSDRCWDWO;;;SY)(A;;CCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLOCRRC;;;BU)" />
      </ServiceInstall>
      <ServiceControl Id="ControlCoreService"
                      Name="SuavoAgent.Core"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="BrokerService"
               Directory="INSTALLFOLDER"
               Guid="{122BBA3F-CBAA-4944-A6E3-C9943AAE2E3D}">
      <File Id="BrokerExecutable"
            Name="SuavoAgent.Broker.exe"
            Source="$(PayloadRoot)/Broker/SuavoAgent.Broker.exe"
            KeyPath="yes"
            Vital="yes" />
      <ServiceInstall Id="InstallBrokerService"
                      Name="SuavoAgent.Broker"
                      DisplayName="SuavoAgent Session Broker"
                      Description="Suavo pharmacy agent - interactive session broker"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes">
        <ServiceDependency Id="SuavoAgent.Core" />
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="5"
                            ResetPeriodInDays="1" />
        <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRSDRCWDWO;;;SY)(A;;CCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLOCRRC;;;BU)" />
      </ServiceInstall>
      <ServiceControl Id="ControlBrokerService"
                      Name="SuavoAgent.Broker"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="WatchdogService"
               Directory="INSTALLFOLDER"
               Guid="{0515325B-47BD-4498-BEE7-0F044BDE1FA6}">
      <File Id="WatchdogExecutable"
            Name="SuavoAgent.Watchdog.exe"
            Source="$(PayloadRoot)/Watchdog/SuavoAgent.Watchdog.exe"
            KeyPath="yes"
            Vital="yes" />
      <ServiceInstall Id="InstallWatchdogService"
                      Name="SuavoAgent.Watchdog"
                      DisplayName="SuavoAgent Watchdog"
                      Description="Suavo pharmacy agent - native watchdog and maintenance coordinator"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10"
                            ResetPeriodInDays="1" />
        <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRSDRCWDWO;;;SY)(A;;CCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLOCRRC;;;BU)" />
      </ServiceInstall>
      <ServiceControl Id="ControlWatchdogService"
                      Name="SuavoAgent.Watchdog"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <Component Id="InteractiveHelper"
               Directory="INSTALLFOLDER"
               Guid="{5EDDEB95-F836-4B03-898D-55FD48FBB965}">
      <File Id="HelperExecutable"
            Name="SuavoAgent.Helper.exe"
            Source="$(PayloadRoot)/Helper/SuavoAgent.Helper.exe"
            KeyPath="yes"
            Vital="yes">
        <PermissionEx Sddl="D:P(A;;FA;;;SY)(A;;FA;;;BA)(A;;0x1200a9;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;;0x1200a9;;;BU)" />
      </File>
    </Component>

    <Component Id="NativeMaintenanceHost"
               Directory="INSTALLFOLDER"
               Guid="{AE344629-3D44-4FC7-AEA1-5992B55083DD}">
      <File Id="MaintenanceExecutable"
            Name="SuavoAgent.Maintenance.exe"
            Source="$(PayloadRoot)/Setup/SuavoSetup.exe"
            KeyPath="yes"
            Vital="yes" />
      <File Id="InstallState"
            Name="install-state.json"
            Source="$(MetadataRoot)/install-state.json"
            DefaultVersion="$(SuavoAgentVersion)"
            Vital="yes" />
    </Component>

    <!-- The MSI owns the runtime cohort; the installed maintenance app owns
         configuration only. This all-users shortcut is the direct-MSI path to
         the visible device-code UI. It never invokes a shell or carries a
         credential on the command line. The HKLM path also gives Burn a
         protected ApprovedExeForElevation target for its success-page action. -->
    <Component Id="NativeOnboardingEntry"
               Directory="SuavoAgentProgramMenuFolder"
               Guid="{829C3E33-42DA-42DE-9215-D2471520D8F5}">
      <Shortcut Id="ConnectSuavoAgentShortcut"
                Name="Connect SuavoAgent"
                Description="Connect this workstation to the Suavo pharmacy dashboard"
                Target="[#MaintenanceExecutable]"
                Arguments="--connect-installed"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveSuavoAgentProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\MKM Technologies LLC\SuavoAgent"
                     Name="MaintenancePath"
                     Value="[#MaintenanceExecutable]"
                     Type="string"
                     KeyPath="yes" />
    </Component>

    <Component Id="BootstrapConfiguration"
               Directory="INSTALLFOLDER"
               Guid="{4E0C19FE-45D1-46E8-8759-292C945DF03D}"
               NeverOverwrite="yes">
      <File Id="BootstrapAppSettings"
            Name="appsettings.json"
            Source="$(PayloadRoot)/Core/appsettings.json"
            KeyPath="yes"
            Vital="yes" />
    </Component>

    <Component Id="DataDirectoryPermissions"
               Directory="DATAFOLDER"
               Guid="{42549F83-D3C9-47FB-9AC9-4DE67244B8DB}"
               Permanent="yes">
      <CreateFolder Directory="DATAFOLDER">
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;;0x1200a9;;;BU)" />
      </CreateFolder>
      <CreateFolder Directory="LOGSFOLDER">
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;;0x1200a9;;;BU)" />
      </CreateFolder>
      <CreateFolder Directory="HELPERLOGFOLDER">
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;OICI;0x1301bf;;;BU)" />
      </CreateFolder>
      <CreateFolder Directory="DIAGNOSTICSFOLDER">
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;;0x1200a9;;;BU)" />
      </CreateFolder>
      <CreateFolder Directory="HELPERDIAGNOSTICSFOLDER">
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;OICI;0x1301bf;;;BU)" />
      </CreateFolder>
      <CreateFolder Directory="HONEYTOKENFOLDER">
        <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3161787503-2860973704-3751597344-303720228-1013404410)(A;OICI;0x1301bf;;;BU)" />
      </CreateFolder>
    </Component>

    <Component Id="IntegrityMetadata"
               Directory="DATAFOLDER"
               Guid="{6E67B861-51EC-451F-814E-8D26F3AB27F2}">
      <File Id="BinaryManifest"
            Name="binaries.manifest"
            Source="$(MetadataRoot)/binaries.manifest"
            DefaultVersion="$(SuavoAgentVersion)"
            KeyPath="yes"
            Vital="yes" />
    </Component>

    <Component Id="LegacyInstallCleanup"
               Directory="INSTALLFOLDER"
               Guid="{8BE48270-8BE0-40B9-90A5-7F945974AD54}">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\MKM Technologies LLC\SuavoAgent"
                     Name="InstallerGeneration"
                     Value="wix7-msi-v1"
                     Type="string"
                     KeyPath="yes" />
      <RemoveRegistryKey Id="RemoveLegacyArpEntry"
                         Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\SuavoAgent"
                         Action="removeOnInstall" />
      <RemoveFile Id="RemoveLegacyBootstrapScript" Name="bootstrap.ps1" On="both" />
      <RemoveFile Id="RemoveLegacyInstallScript" Name="install.ps1" On="both" />
      <RemoveFile Id="RemoveLegacyQuickInstallScript" Name="quick-install.ps1" On="both" />
      <RemoveFile Id="RemoveLegacySetupScript" Name="setup-windows.ps1" On="both" />
      <RemoveFile Id="RemoveLegacyCheckScript" Name="suavo-check.ps1" On="both" />
      <RemoveFile Id="RemoveLegacySymbols" Name="SuavoAgent.*.pdb" On="install" />
    </Component>
  </Fragment>
</Wix>
