<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows service registration for SuavoAgent.Core, .Broker, .Watchdog.
  Helper is NOT a service — it's a per-user-session Scheduled Task.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>

    <!--
      Core service registration. Attached to the Core component so the
      service is installed/started/stopped/removed together with the
      Core.exe file.

      Start="auto" with DelayedAutoStart="yes" gives Windows time to
      finish boot before Core hits SQL Server. The 60-second recovery
      delays for first/second/third failure provide self-healing
      without ARP-spam on transient flakes.
    -->
    <ComponentGroup Id="CoreServiceComponents" Directory="INSTALLDIR">
      <Component Id="SuavoAgent.Core.Service" Guid="*">
        <CreateFolder />
        <ServiceInstall Id="SuavoAgent_Core_Install"
                        Name="SuavoAgent.Core"
                        DisplayName="Suavo Agent Core"
                        Description="HIPAA-compliant reasoning, state database, and cloud sync for SuavoAgent."
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes"
                        Arguments="--service"
                        Interactive="no">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="SuavoAgent_Core_Control"
                        Name="SuavoAgent.Core"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="BrokerServiceComponents" Directory="INSTALLDIR">
      <Component Id="SuavoAgent.Broker.Service" Guid="*">
        <CreateFolder />
        <ServiceInstall Id="SuavoAgent_Broker_Install"
                        Name="SuavoAgent.Broker"
                        DisplayName="Suavo Agent IPC Broker"
                        Description="Named-pipe message bus connecting SuavoAgent Core, Helper, and Watchdog."
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes"
                        Arguments="--service"
                        Interactive="no">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="SuavoAgent_Broker_Control"
                        Name="SuavoAgent.Broker"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Watchdog is intentionally the LAST service installed and FIRST to
      stop on uninstall, so it doesn't restart Core/Broker while the MSI
      is mid-uninstall.

      Watchdog has elevated permissions to invoke bootstrap.ps1 -Repair
      as a self-healing last-resort. ACLs on the install directory keep
      non-privileged users from injecting alternate scripts.
    -->
    <ComponentGroup Id="WatchdogServiceComponents" Directory="INSTALLDIR">
      <Component Id="SuavoAgent.Watchdog.Service" Guid="*">
        <CreateFolder />
        <ServiceInstall Id="SuavoAgent_Watchdog_Install"
                        Name="SuavoAgent.Watchdog"
                        DisplayName="Suavo Agent Watchdog"
                        Description="Restarts SuavoAgent Core and Broker on failure; runs self-repair as last resort."
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes"
                        Arguments="--service"
                        Interactive="no">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="SuavoAgent_Watchdog_Control"
                        Name="SuavoAgent.Watchdog"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
