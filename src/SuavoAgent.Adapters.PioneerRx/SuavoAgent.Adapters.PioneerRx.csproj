<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SuavoAgent.Adapters.PioneerRx</RootNamespace>
    <AssemblyTitle>SuavoAgent.Adapters.PioneerRx</AssemblyTitle>
    <Description>Suavo PMS adapter for PioneerRx pharmacy management system.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- SqlClient 5.2.2's legacy Windows RID graph otherwise selects the
         vulnerable System.Private.Uri 4.3.0 package. Pin the patched servicing
         release until SqlClient removes that transitive floor. -->
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Contracts\SuavoAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Adapters.PioneerRx.Tests" />
  </ItemGroup>

</Project>
