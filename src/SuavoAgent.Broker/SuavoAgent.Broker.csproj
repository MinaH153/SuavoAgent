<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>SuavoAgent.Broker</AssemblyTitle>
    <Description>Suavo pharmacy agent broker — writeback dispatcher and fleet command relay.</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Explicit current servicing pin; TraceEvent 3.2 requires the 9.x serializer line. -->
    <PackageReference Include="System.Text.Json" Version="9.0.17" />
    <!-- Honeytoken ETW attribution oracle (Windows-only at runtime; managed lib builds cross-platform, all
         ETW calls guarded by OperatingSystem.IsWindows()). Native KernelTraceControl bits ride the win-x64
         self-contained publish (IncludeNativeLibrariesForSelfExtract above). -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.4" />
    <!-- Override TraceEvent's netstandard-era access-control floor with the maintained package. -->
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Contracts\SuavoAgent.Contracts.csproj" />
    <ProjectReference Include="..\SuavoAgent.Diagnostics\SuavoAgent.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Broker.Tests" />
  </ItemGroup>

</Project>
