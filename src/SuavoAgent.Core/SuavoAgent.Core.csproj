<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SuavoAgent.Core</RootNamespace>
    <AssemblyTitle>SuavoAgent.Core</AssemblyTitle>
    <Description>Suavo pharmacy intelligence agent — SQL polling, PMS observation, cloud sync.</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- LLamaSharp.Backend.Cpu ships multiple AVX variants under runtimes/<rid>/native/{avx,avx2,avx512}.
         LLamaSharp auto-selects the right one at runtime; we just need the publish step to allow the
         parallel files. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Stateless" Version="5.20.1" />
    <!-- ClosedXML (MIT) replaces EPPlus (NonCommercial in v7). Commercial pilot cannot ship
         EPPlus under its free license; re-evaluation only if ClosedXML perf blocks a workflow. -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.17" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Managed LLamaSharp binding only. Native llama.cpp backend (llama.dll,
         ggml.dll) is NOT shipped by default — its presence would be a vendor
         fingerprint. When Reasoning.Enabled=true the operator provides these
         binaries at ReasoningOptions.NativeLibraryPath. Default installs
         contain zero Tier-2 native code. See Codex C-1.
         0.24.0 = first LLamaSharp whose bundled llama.cpp (ceda28ef) supports Qwen3 (needs >= b5092).
         All APIs we use are byte-identical to 0.19.0 (zero call-site edits). The native DLL set grows
         3->5 per AVX folder (ggml.dll + ggml-base.dll + ggml-cpu.dll + llama.dll + llava_shared.dll) —
         the operator-provided NativeLibraryPath on the box MUST carry all 5 (see live-box-validation runbook).
         Backend pin (LLamaSharp.Backend.Cpu, in Helper.Tests) MUST equal this version exactly. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Contracts\SuavoAgent.Contracts.csproj" />
    <ProjectReference Include="..\SuavoAgent.Adapters.PioneerRx\SuavoAgent.Adapters.PioneerRx.csproj" />
    <ProjectReference Include="..\SuavoAgent.Diagnostics\SuavoAgent.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Config\adapters\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Rules ship embedded in the single-file assembly so the agent is
         self-contained — no external YAML dependency, no signing gap.
         Also kept on disk next to the exe for tests and operator overrides. -->
    <EmbeddedResource Include="Reasoning\Rules\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
