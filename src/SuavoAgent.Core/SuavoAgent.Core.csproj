<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SuavoAgent.Core</RootNamespace>
    <AssemblyTitle>SuavoAgent.Core</AssemblyTitle>
    <Description>Suavo pharmacy intelligence agent — SQL polling, PMS observation, cloud sync.</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Keep this even though the production Core references only the managed LLamaSharp binding.
         Other native libraries (SQLCipher) still self-extract. LLamaSharp.Backend.Cpu is deliberately
         NOT a direct production PackageReference: its four win-x64 AVX folders contain duplicate DLL
         basenames that cannot be represented in this signed single-file bundle. The installer/runtime
         instead retain the exact SHA-pinned 0.24.0 nupkg and safely flatten only win-x64/noavx into the
         protected content-addressed Brain cohort. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Stateless" Version="5.20.1" />
    <!-- ClosedXML (MIT) replaces EPPlus (NonCommercial in v7). Commercial pilot cannot ship
         EPPlus under its free license; re-evaluation only if ClosedXML perf blocks a workflow. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- Managed LLamaSharp binding only. Native llama.cpp backend (llama.dll,
         ggml.dll) is installed from the exact SHA-pinned, repository-signed
         LLamaSharp.Backend.Cpu nupkg into ReasoningOptions.NativeLibraryPath.
         Keeping the backend outside the Core single-file preserves the protected,
         content-addressed activation proof and avoids duplicate AVX bundle paths.
         0.24.0 = first LLamaSharp whose bundled llama.cpp (ceda28ef) supports Qwen3 (needs >= b5092).
         All APIs we use are byte-identical to 0.19.0 (zero call-site edits). The native DLL set grows
         3->5 per AVX folder (ggml.dll + ggml-base.dll + ggml-cpu.dll + llama.dll + llava_shared.dll).
         Backend pin (LLamaSharp.Backend.Cpu, in Helper.Tests) MUST equal this version exactly. -->
    <PackageReference Include="LLamaSharp" Version="0.24.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Contracts\SuavoAgent.Contracts.csproj" />
    <ProjectReference Include="..\SuavoAgent.Adapters.PioneerRx\SuavoAgent.Adapters.PioneerRx.csproj" />
    <ProjectReference Include="..\SuavoAgent.Diagnostics\SuavoAgent.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Config\adapters\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Rules ship embedded in the single-file assembly so the agent is
         self-contained — no external YAML dependency, no signing gap.
         Also kept on disk next to the exe for tests and operator overrides. -->
    <EmbeddedResource Include="Reasoning\Rules\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>
