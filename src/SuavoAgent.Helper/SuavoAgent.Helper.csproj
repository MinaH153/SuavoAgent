<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
    <AssemblyTitle>SuavoAgent.Helper</AssemblyTitle>
    <Description>Suavo pharmacy agent helper — desktop UI automation and vision capture.</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Helper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA2" Version="5.0.0" />
    <!-- UIA3 — modern Windows Accessibility framework. Used as the
         default-OFF feature-flag path in PioneerRxUiaEngine. UIA2 stays
         as the fallback for WinForms apps where UIA3 returns zero
         useful elements. Codex 2026-04-26 review flagged UIA2 as the
         likely contributor to Trip A's hard reset (slow tree
         enumeration on PioneerRx's deep WinForms tree); UIA3 is
         5-10× faster but needs onsite verification before flip. -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.6" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- System.Drawing.Common: GDI BitBlt screen capture. Windows-only supported
         surface; guarded at runtime with OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- Tesseract OCR managed wrapper only. Native tesseract.dll + leptonica
         binaries are operator-provided at TesseractOptions.NativeLibraryPath,
         same stealth pattern as LLamaSharp (Codex C-1 precedent). -->
    <PackageReference Include="Tesseract" Version="5.2.0" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Contracts\SuavoAgent.Contracts.csproj" />
    <ProjectReference Include="..\SuavoAgent.Core\SuavoAgent.Core.csproj" />
  </ItemGroup>

</Project>
