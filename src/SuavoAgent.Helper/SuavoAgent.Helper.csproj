<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
    <AssemblyTitle>SuavoAgent.Helper</AssemblyTitle>
    <Description>Suavo pharmacy agent helper — desktop UI automation and vision capture.</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Required to cross-build the Microsoft.WindowsDesktop.App framework reference (UIAutomationClient for FlaUI.UIA2) when publishing win-x64 from a Linux CI host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Helper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA2" Version="5.0.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.6" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- System.Drawing.Common: exact-window PrintWindow rendering + PNG encoding.
         Full-monitor/framebuffer capture is intentionally not implemented. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- Retain the managed Tesseract.dll wrapper, but exclude the package's build
         target that copies its unreviewed x86/x64 tesseract50 + Leptonica DLLs.
         Native code may enter only through the separately approved cohort. -->
    <PackageReference Include="Tesseract" Version="5.2.0"
                      ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Contracts\SuavoAgent.Contracts.csproj" />
    <ProjectReference Include="..\SuavoAgent.Core\SuavoAgent.Core.csproj" />
    <ProjectReference Include="..\SuavoAgent.Diagnostics\SuavoAgent.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the panda ships inside single-file and framework-dependent
         publish outputs; no mutable external image path is trusted at runtime. -->
    <EmbeddedResource Include="Assets\pharmacist-panda-v2.png"
                      LogicalName="SuavoAgent.Helper.Assets.pharmacist-panda-v2.png" />
  </ItemGroup>

</Project>
