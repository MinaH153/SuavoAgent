<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
        xmlns:views="using:SuavoAgent.Setup.Gui.Views"
        mc:Ignorable="d"
        d:DesignWidth="960" d:DesignHeight="640"
        x:Class="SuavoAgent.Setup.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SuavoAgent Setup"
        Icon="/Assets/suavo-logo.png"
        Width="960" Height="640"
        MinWidth="760" MinHeight="520"
        Background="{DynamicResource SuavoBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Title strip -->
        <Border Grid.Row="0"
                Background="{DynamicResource SuavoSurfaceBrush}"
                BorderBrush="{DynamicResource SuavoBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="56">
            <DockPanel LastChildFill="False" Margin="24,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="/Assets/suavo-logo.png"
                           Width="28" Height="28"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="SuavoAgent Setup"
                               Foreground="{DynamicResource SuavoTextBrush}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding StepLabel}"
                           Foreground="{DynamicResource SuavoTextMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Step content -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"
                        Background="{DynamicResource SuavoBackgroundBrush}"/>

        <!-- Footer trust line -->
        <Border Grid.Row="2"
                Background="{DynamicResource SuavoSurfaceBrush}"
                BorderBrush="{DynamicResource SuavoBorderBrush}"
                BorderThickness="0,1,0,0"
                Height="36">
            <Grid ColumnDefinitions="*,Auto,*" Margin="20,0">
                <TextBlock Grid.Column="1"
                           Text="Suavo LLC · HIPAA-first pharmacy safeguards"
                           Foreground="{DynamicResource SuavoTextSubtleBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="8,2"
                        FontSize="11"
                        Click="OpenThirdPartyNotices"
                        AutomationProperties.Name="Open third-party software notices"
                        ToolTip.Tip="Licenses and provenance for software included with SuavoAgent">
                    Third-party notices
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
