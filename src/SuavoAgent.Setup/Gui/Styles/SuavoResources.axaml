<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Suavo palette — Light Sapphire (2026-07-01, sub-project 1b).
        Mirrors the web light-sapphire connect experience (Suavo/src/lib/suavoagent-theme.ts):
        cool white canvas, white elevated surfaces, slate ink, SAPPHIRE accent — so the
        installer app and the cloud dashboard read as ONE product (install → connect → manage).
        Accent has two roles: SuavoAccent (#1D4ED8) for fills/buttons, and SuavoAccentText
        (#1D4ED8) for sapphire text/eyebrows. Because sapphire is a DARK fill, label text on
        accent fills is WHITE (SuavoAccentTextInverse) — the inverse of the old gold theme.
        Status colors match the cloud (online/warn/offline). Animations: spring (view layer).
    -->

    <Color x:Key="SuavoBackground">#F8FAFC</Color>
    <Color x:Key="SuavoSurface">#FFFFFF</Color>
    <Color x:Key="SuavoCard">#FFFFFF</Color>
    <Color x:Key="SuavoBorder">#E2E8F0</Color>

    <Color x:Key="SuavoAccent">#1D4ED8</Color>
    <Color x:Key="SuavoAccentHover">#2563EB</Color>
    <Color x:Key="SuavoAccentPressed">#1E40AF</Color>
    <Color x:Key="SuavoAccentMuted">#EFF4FF</Color>
    <Color x:Key="SuavoAccentText">#1D4ED8</Color>

    <Color x:Key="SuavoText">#0F172A</Color>
    <Color x:Key="SuavoTextMuted">#475569</Color>
    <Color x:Key="SuavoTextSubtle">#94A3B8</Color>

    <Color x:Key="SuavoSuccess">#16A34A</Color>
    <Color x:Key="SuavoWarning">#EA580C</Color>
    <Color x:Key="SuavoDanger">#DC2626</Color>

    <SolidColorBrush x:Key="SuavoBackgroundBrush" Color="{StaticResource SuavoBackground}" />
    <SolidColorBrush x:Key="SuavoSurfaceBrush" Color="{StaticResource SuavoSurface}" />
    <SolidColorBrush x:Key="SuavoCardBrush" Color="{StaticResource SuavoCard}" />
    <SolidColorBrush x:Key="SuavoBorderBrush" Color="{StaticResource SuavoBorder}" />

    <SolidColorBrush x:Key="SuavoAccentBrush" Color="{StaticResource SuavoAccent}" />
    <SolidColorBrush x:Key="SuavoAccentHoverBrush" Color="{StaticResource SuavoAccentHover}" />
    <SolidColorBrush x:Key="SuavoAccentPressedBrush" Color="{StaticResource SuavoAccentPressed}" />
    <SolidColorBrush x:Key="SuavoAccentMutedBrush" Color="{StaticResource SuavoAccentMuted}" />
    <SolidColorBrush x:Key="SuavoAccentTextBrush" Color="{StaticResource SuavoAccentText}" />

    <SolidColorBrush x:Key="SuavoTextBrush" Color="{StaticResource SuavoText}" />
    <SolidColorBrush x:Key="SuavoTextMutedBrush" Color="{StaticResource SuavoTextMuted}" />
    <SolidColorBrush x:Key="SuavoTextSubtleBrush" Color="{StaticResource SuavoTextSubtle}" />

    <SolidColorBrush x:Key="SuavoSuccessBrush" Color="{StaticResource SuavoSuccess}" />
    <SolidColorBrush x:Key="SuavoWarningBrush" Color="{StaticResource SuavoWarning}" />
    <SolidColorBrush x:Key="SuavoDangerBrush" Color="{StaticResource SuavoDanger}" />

    <CornerRadius x:Key="SuavoRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="SuavoRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="SuavoRadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="SuavoRadiusPill">999</CornerRadius>

    <!-- Deferred / self-healing is informational sapphire, never warning amber. -->
    <Color x:Key="SuavoDeferred">#2563EB</Color>
    <SolidColorBrush x:Key="SuavoDeferredBrush" Color="{StaticResource SuavoDeferred}" />

    <!-- Elevated surface for chips / pills sitting on cards — cool slate tint. -->
    <Color x:Key="SuavoSurfaceElevated">#F1F5F9</Color>
    <SolidColorBrush x:Key="SuavoSurfaceElevatedBrush" Color="{StaticResource SuavoSurfaceElevated}" />

    <!-- Depth gradients — cool sapphire undertone (matches the cloud radial canvas). -->
    <LinearGradientBrush x:Key="SuavoBackgroundGradientBrush" StartPoint="0%,0%" EndPoint="50%,100%">
        <GradientStop Color="#FBFCFF" Offset="0" />
        <GradientStop Color="#EEF3FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuavoCardGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuavoAccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="0.55" />
        <GradientStop Color="#1E40AF" Offset="1" />
    </LinearGradientBrush>

    <!-- Hairline sapphire accent for hero rules. -->
    <LinearGradientBrush x:Key="SuavoAccentRuleBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#1D4ED8" Offset="0" />
        <GradientStop Color="#1D4ED800" Offset="1" />
    </LinearGradientBrush>

    <!-- Text on sapphire (CTA labels sitting on SuavoAccent fills) — WHITE, since sapphire is dark. -->
    <Color x:Key="SuavoAccentTextInverse">#FFFFFF</Color>
    <SolidColorBrush x:Key="SuavoAccentTextInverseBrush" Color="{StaticResource SuavoAccentTextInverse}" />

    <!-- Console/log panel — the one intentionally dark surface, cool slate to match the cloud ink. -->
    <Color x:Key="SuavoLogBackground">#0F172A</Color>
    <SolidColorBrush x:Key="SuavoLogBackgroundBrush" Color="{StaticResource SuavoLogBackground}" />

</ResourceDictionary>
