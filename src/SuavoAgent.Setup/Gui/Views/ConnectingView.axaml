<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="SuavoAgent.Setup.Gui.Views.ConnectingView"
             x:DataType="vm:ConnectingViewModel">

    <Grid Margin="80,48">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
            <Image Source="/Assets/suavo-logo.png"
                   Width="64" Height="64"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <ProgressBar IsIndeterminate="True" Width="240"
                         Foreground="{DynamicResource SuavoAccentBrush}"/>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource SuavoTextBrush}"
                       FontSize="20" FontWeight="Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Linking this workstation to your Suavo dashboard — no code needed."
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="13"
                       MaxWidth="400" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
