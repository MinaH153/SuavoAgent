<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="SuavoAgent.Setup.Gui.Views.ConsentView"
             x:DataType="vm:ConsentViewModel">

    <UserControl.Styles>
        <!-- The CTA is ALWAYS visible: enabled = gold gradient; disabled = a clearly
             styled, still-readable button (never invisible, never a mystery). -->
        <Style Selector="Button.cta">
            <Setter Property="Background" Value="{DynamicResource SuavoAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuavoAccentTextInverseBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SuavoAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.cta:disabled">
            <Setter Property="Background" Value="{DynamicResource SuavoSurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuavoTextSubtleBrush}" />
            <Setter Property="Cursor" Value="No" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.cta:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SuavoSurfaceElevatedBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="CheckBox.consent">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{DynamicResource SuavoTextBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Auto header · *(scrollable disclosure) · Auto authorizing-party · Auto consent · Auto CTA.
         Only the disclosure row scrolls, so required inputs + CTA are always reachable. Tighter
         side margins than 80 so the form fits at 760px-min / high-DPI without horizontal crowding. -->
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="56,24,56,24">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Terms &amp; consent"
                       Foreground="{DynamicResource SuavoTextBrush}"
                       FontSize="28" FontWeight="Light"/>
            <TextBlock Text="SuavoAgent observes workstation activity to automate your regulated workflows. Nothing uploads until you agree."
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"/>
            <Border Height="2" Width="64" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Background="{DynamicResource SuavoAccentRuleBrush}" CornerRadius="1"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,14"
                Background="{DynamicResource SuavoCardGradientBrush}"
                BorderBrush="{DynamicResource SuavoBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SuavoRadiusLarge}">
            <ScrollViewer Padding="28,22">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="6">
                        <TextBlock Text="What it collects"
                                   Foreground="{DynamicResource SuavoAccentTextBrush}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Application usage patterns and durations; workstation hardware profile; shift timing from login / logout; website domain categories (not URLs); print event counts (not document content)."
                                   Foreground="{DynamicResource SuavoTextBrush}"
                                   FontSize="13" LineHeight="20"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="What it never collects"
                                   Foreground="{DynamicResource SuavoSuccessBrush}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Keystrokes, passwords, or typed text; screen captures or screenshots; email / chat / message content; personal browsing history or specific URLs; file contents or document data."
                                   Foreground="{DynamicResource SuavoTextBrush}"
                                   FontSize="13" LineHeight="20"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Legal requirements"
                                   Foreground="{DynamicResource SuavoDangerBrush}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="CT, DE, NY require written employee notice before monitoring. CA requires CCPA notice at collection. Employee notification is recommended best practice in every state."
                                   Foreground="{DynamicResource SuavoTextBrush}"
                                   FontSize="13" LineHeight="20"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Authorizing party — ALWAYS visible below the (scrollable) disclosure card, so the
             required legal inputs never fall below the fold at small windows / high-DPI scaling.
             Only the disclosure text above scrolls; name/title/state + checkbox + CTA stay pinned. -->
        <Grid Grid.Row="2" ColumnDefinitions="3*,3*,2*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                       Text="Authorizing party"
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="12" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,8,12,0"
                     Text="{Binding Name, Mode=TwoWay}"
                     Watermark="Full name"
                     Background="{DynamicResource SuavoSurfaceBrush}"
                     Foreground="{DynamicResource SuavoTextBrush}"
                     BorderBrush="{DynamicResource SuavoBorderBrush}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,12,0"
                     Text="{Binding Title, Mode=TwoWay}"
                     Watermark="Title (Owner, Manager, …)"
                     Background="{DynamicResource SuavoSurfaceBrush}"
                     Foreground="{DynamicResource SuavoTextBrush}"
                     BorderBrush="{DynamicResource SuavoBorderBrush}"/>
            <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                      ItemsSource="{Binding States}"
                      SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                      PlaceholderText="State"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource SuavoSurfaceBrush}"
                      Foreground="{DynamicResource SuavoTextBrush}"
                      BorderBrush="{DynamicResource SuavoBorderBrush}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:UsState">
                        <TextBlock Text="{Binding Display}"
                                   Foreground="{DynamicResource SuavoTextBrush}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"
                    IsVisible="{Binding NoticeBannerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource SuavoAccentMutedBrush}"
                    BorderBrush="{DynamicResource SuavoWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource SuavoRadiusSmall}"
                    Padding="12,8">
                <TextBlock Text="{Binding NoticeBannerText}"
                           Foreground="{DynamicResource SuavoWarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,12">
            <CheckBox Classes="consent"
                      IsChecked="{Binding AgreedToTerms, Mode=TwoWay}"
                      FontSize="13"
                      Content="I authorize SuavoAgent to monitor this workstation and accept Suavo's Terms and Privacy Policy."/>
            <CheckBox Classes="consent"
                      IsChecked="{Binding AgreedToNotice, Mode=TwoWay}"
                      IsVisible="{Binding RequiresEmployeeNotice}"
                      FontSize="13"
                      Content="I have distributed the employee notice template to all staff at this workstation."/>
        </StackPanel>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                <!-- Live "what's missing" helper — replaces the old silent disabled button. -->
                <TextBlock Text="{Binding MissingHint}"
                           IsVisible="{Binding MissingHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource SuavoAccentTextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="Consent is recorded digitally and uploaded on first heartbeat."
                           Foreground="{DynamicResource SuavoTextSubtleBrush}"
                           FontSize="11"/>
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Classes="cta"
                    Content="Agree &amp; continue"
                    Command="{Binding AgreeCommand}"
                    Padding="24,12"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    CornerRadius="10"/>
        </DockPanel>

    </Grid>
</UserControl>
