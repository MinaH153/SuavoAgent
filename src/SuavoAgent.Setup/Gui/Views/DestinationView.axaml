<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="SuavoAgent.Setup.Gui.Views.DestinationView"
             x:DataType="vm:DestinationViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="80,32,80,32">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="{Binding PageTitle}"
                       Foreground="{DynamicResource SuavoTextBrush}"
                       FontSize="28" FontWeight="Light"/>
            <TextBlock Text="{Binding PageDetail}"
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24"
                Background="{DynamicResource SuavoCardBrush}"
                BorderBrush="{DynamicResource SuavoBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SuavoRadiusLarge}"
                Padding="24">
            <StackPanel Spacing="18">

                <StackPanel Spacing="6">
                    <TextBlock Text="Install path"
                               Foreground="{DynamicResource SuavoAccentTextBrush}"
                               FontWeight="SemiBold" FontSize="12"/>
                    <TextBox Text="{Binding InstallPath, Mode=TwoWay}"
                             IsReadOnly="{Binding IsInstallPathLocked}"
                             Background="{DynamicResource SuavoSurfaceBrush}"
                             Foreground="{DynamicResource SuavoTextBrush}"
                             BorderBrush="{DynamicResource SuavoBorderBrush}"/>
                    <TextBlock Text="Services read from this folder. Default: C:\Program Files\Suavo\Agent"
                               Foreground="{DynamicResource SuavoTextSubtleBrush}"
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="SQL Server"
                               Foreground="{DynamicResource SuavoAccentTextBrush}"
                               FontWeight="SemiBold" FontSize="12"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,0">
                        <TextBox Grid.Column="0" Margin="0,0,12,0"
                                 Text="{Binding SqlServer, Mode=TwoWay}"
                                 Watermark="host\instance,port"
                                 Background="{DynamicResource SuavoSurfaceBrush}"
                                 Foreground="{DynamicResource SuavoTextBrush}"
                                 BorderBrush="{DynamicResource SuavoBorderBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SqlDatabase, Mode=TwoWay}"
                                 Watermark="Database"
                                 Background="{DynamicResource SuavoSurfaceBrush}"
                                 Foreground="{DynamicResource SuavoTextBrush}"
                                 BorderBrush="{DynamicResource SuavoBorderBrush}"/>
                    </Grid>
                    <TextBlock Text="Pre-filled from auto-discovery. Override only if you know the value."
                               Foreground="{DynamicResource SuavoTextSubtleBrush}"
                               FontSize="11"/>

                    <Border IsVisible="{Binding IsSqlMissing}"
                            Background="{DynamicResource SuavoSurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource SuavoDangerBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="!" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Top" Margin="0,1,10,0"
                                       Foreground="{DynamicResource SuavoDangerBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="PioneerRx SQL is required"
                                           Foreground="{DynamicResource SuavoTextBrush}"
                                           FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Setup cannot activate, rotate device authority, or report this pharmacy workstation ready until the detected SQL connection is complete. Return to System Check or enter the verified values."
                                           Foreground="{DynamicResource SuavoTextMutedBrush}"
                                           FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="6">
                    <CheckBox IsChecked="{Binding UseSqlAuth, Mode=TwoWay}"
                              Foreground="{DynamicResource SuavoTextBrush}"
                              Content="Use SQL authentication (instead of Windows pass-through)"/>
                    <Grid ColumnDefinitions="*,*" IsVisible="{Binding UseSqlAuth}">
                        <TextBox Grid.Column="0" Margin="0,6,12,0"
                                 Text="{Binding SqlUser, Mode=TwoWay}"
                                 Watermark="SQL username"
                                 Background="{DynamicResource SuavoSurfaceBrush}"
                                 Foreground="{DynamicResource SuavoTextBrush}"
                                 BorderBrush="{DynamicResource SuavoBorderBrush}"/>
                        <TextBox Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding SqlPassword, Mode=TwoWay}"
                                 Watermark="SQL password"
                                 PasswordChar="●"
                                 Background="{DynamicResource SuavoSurfaceBrush}"
                                 Foreground="{DynamicResource SuavoTextBrush}"
                                 BorderBrush="{DynamicResource SuavoBorderBrush}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="SQL server certificate (optional)"
                               Foreground="{DynamicResource SuavoAccentTextBrush}"
                               FontWeight="SemiBold" FontSize="12"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Margin="0,0,8,0"
                                 Text="{Binding SqlCertificatePath}"
                                 Watermark="Needed only when SQL Server uses a self-signed certificate"
                                 IsReadOnly="True"
                                 Background="{DynamicResource SuavoSurfaceBrush}"
                                 Foreground="{DynamicResource SuavoTextBrush}"
                                 BorderBrush="{DynamicResource SuavoBorderBrush}"/>
                        <Button Grid.Column="1" Margin="0,0,8,0"
                                Content="Choose certificate…"
                                Command="{Binding SelectSqlCertificateCommand}"
                                Padding="14,8"/>
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding ClearSqlCertificateCommand}"
                                IsVisible="{Binding HasSqlCertificate}"
                                Padding="12,8"/>
                    </Grid>
                    <TextBlock Text="{Binding SqlCertificateStatus}"
                               Foreground="{DynamicResource SuavoTextSubtleBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding ActionHint}"
                       Foreground="{DynamicResource SuavoTextSubtleBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="{Binding ActionLabel}"
                    Command="{Binding InstallCommand}"
                    Padding="28,12"
                    Background="{DynamicResource SuavoAccentBrush}"
                    Foreground="{DynamicResource SuavoAccentTextInverseBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    CornerRadius="10"/>
        </DockPanel>

    </Grid>
</UserControl>
