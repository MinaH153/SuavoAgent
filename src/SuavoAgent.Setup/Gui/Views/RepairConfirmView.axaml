<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="SuavoAgent.Setup.Gui.Views.RepairConfirmView"
             x:DataType="vm:RepairConfirmViewModel">

    <Grid RowDefinitions="*,Auto,Auto,Auto,*" Margin="80,32">
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="14">
            <Border Width="64" Height="64"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SuavoAccentBrush}"
                    CornerRadius="32">
                <TextBlock Text="↻"
                           Foreground="{DynamicResource SuavoAccentTextInverseBrush}"
                           FontSize="36" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Repair SuavoAgent services"
                       Foreground="{DynamicResource SuavoTextBrush}"
                       FontSize="34" FontWeight="Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Verify the existing signed files, then reassert protected Windows service settings without deleting pharmacy data, downloading code, or pairing a new device."
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="560"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,28,0,0"
                HorizontalAlignment="Center"
                MinWidth="460"
                Background="{DynamicResource SuavoCardBrush}"
                BorderBrush="{DynamicResource SuavoBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SuavoRadiusLarge}"
                Padding="22,16">
            <StackPanel Spacing="9">
                <TextBlock Text="Service repair will:"
                           Foreground="{DynamicResource SuavoTextSubtleBrush}"
                           FontSize="12"/>
                <TextBlock Text="✓ Verify every installed binary and signed release record"
                           Foreground="{DynamicResource SuavoTextBrush}" FontSize="12"/>
                <TextBlock Text="✓ Reassert least-privilege folder and service permissions"
                           Foreground="{DynamicResource SuavoTextBrush}" FontSize="12"/>
                <TextBlock Text="✓ Restart and verify Core, Broker, and Watchdog"
                           Foreground="{DynamicResource SuavoTextBrush}" FontSize="12"/>
                <TextBlock Text="✓ Restore the signed Repair/Uninstall entry in Windows Settings"
                           Foreground="{DynamicResource SuavoTextBrush}" FontSize="12"/>
                <TextBlock Text="Repair stops if authenticity, authority recovery, or service health cannot be proven."
                           Foreground="{DynamicResource SuavoTextMutedBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,28,0,0">
            <Button Content="Repair services"
                    Command="{Binding ConfirmCommand}"
                    AutomationProperties.Name="Repair SuavoAgent services"
                    Padding="24,12"
                    Background="{DynamicResource SuavoAccentBrush}"
                    Foreground="{DynamicResource SuavoAccentTextInverseBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    CornerRadius="10"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel repair"
                    Padding="20,12"
                    Background="Transparent"
                    Foreground="{DynamicResource SuavoTextMutedBrush}"
                    BorderBrush="{DynamicResource SuavoBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"/>
        </StackPanel>
    </Grid>
</UserControl>
