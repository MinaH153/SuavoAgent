<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="SuavoAgent.Setup.Gui.Views.UninstallConfirmView"
             x:DataType="vm:UninstallConfirmViewModel">

    <Grid RowDefinitions="*,Auto,Auto,Auto,*" Margin="80,32">

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="14">
            <Border Width="64" Height="64"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SuavoDangerBrush}"
                    CornerRadius="32">
                <TextBlock Text="!"
                           Foreground="#FFFFFF"
                           FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Uninstall SuavoAgent"
                       Foreground="{DynamicResource SuavoTextBrush}"
                       FontSize="34" FontWeight="Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="This removes SuavoAgent and all local data on this computer."
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="520"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,28,0,0"
                HorizontalAlignment="Center"
                MinWidth="440"
                Background="{DynamicResource SuavoCardBrush}"
                BorderBrush="{DynamicResource SuavoBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource SuavoRadiusLarge}"
                Padding="22,16">
            <StackPanel Spacing="10">
                <TextBlock Text="The following will be stopped and deleted:"
                           Foreground="{DynamicResource SuavoTextSubtleBrush}"
                           FontSize="12"/>
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Services" Foreground="{DynamicResource SuavoTextSubtleBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Core · Broker · Watchdog" Foreground="{DynamicResource SuavoTextBrush}" FontSize="12"/>
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Install path" Foreground="{DynamicResource SuavoTextSubtleBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding InstallPath}" Foreground="{DynamicResource SuavoTextBrush}" FontSize="12" FontFamily="Consolas,Menlo,monospace"/>
                    </Grid>
                    <Grid ColumnDefinitions="130,*">
                        <TextBlock Grid.Column="0" Text="Local data" Foreground="{DynamicResource SuavoTextSubtleBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding DataPath}" Foreground="{DynamicResource SuavoTextBrush}" FontSize="12" FontFamily="Consolas,Menlo,monospace"/>
                    </Grid>
                </StackPanel>
                <TextBlock Text="This cannot be undone. Learned templates, audit logs, and saved credentials on this machine are erased."
                           Foreground="{DynamicResource SuavoDangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,28,0,0">
            <Button Content="Uninstall now"
                    Command="{Binding ConfirmCommand}"
                    Padding="24,12"
                    Background="{DynamicResource SuavoDangerBrush}"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    CornerRadius="10"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="20,12"
                    Background="Transparent"
                    Foreground="{DynamicResource SuavoTextMutedBrush}"
                    BorderBrush="{DynamicResource SuavoBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"/>
        </StackPanel>

    </Grid>
</UserControl>
