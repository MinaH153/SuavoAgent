<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SuavoAgent.Setup.Gui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
             x:Class="SuavoAgent.Setup.Gui.Views.UninstallSuccessView"
             x:DataType="vm:UninstallSuccessViewModel">

    <Grid RowDefinitions="*,Auto,Auto,*" Margin="80,32">

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="16">
            <Border Width="72" Height="72"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SuavoSuccessBrush}"
                    CornerRadius="36">
                <TextBlock Text="✓"
                           Foreground="{DynamicResource SuavoAccentTextInverseBrush}"
                           FontSize="40" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Headline}"
                       Foreground="{DynamicResource SuavoTextBrush}"
                       FontSize="34" FontWeight="Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Message}"
                       Foreground="{DynamicResource SuavoTextMutedBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,32,0,0">
            <Button Content="Finish"
                    Command="{Binding FinishCommand}"
                    Padding="28,12"
                    Background="{DynamicResource SuavoAccentBrush}"
                    Foreground="{DynamicResource SuavoAccentTextInverseBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    CornerRadius="10"/>
        </StackPanel>

    </Grid>
</UserControl>
