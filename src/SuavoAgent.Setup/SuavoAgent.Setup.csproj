<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SuavoSetup</AssemblyName>
    <AssemblyTitle>SuavoAgent Setup</AssemblyTitle>
    <Description>Suavo pharmacy agent installer — signed one-click setup with HIPAA BAA consent.</Description>
    <RootNamespace>SuavoAgent.Setup</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- v4 Phase 1: support osx-arm64 + osx-x64 RIDs for Mac DMG packaging.
         Real Mac runtime port is deferred (Helper FlaUI + Core SqlClient/DPAPI
         + WindowsServices need replacement). For now the Mac SuavoSetup.app
         shows a "macOS runtime in active development" placeholder. -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Windows: WinExe (suppresses console window), Win10+ -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <OutputType>WinExe</OutputType>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- macOS: Exe (Avalonia handles windowing), macOS 13+. PublishSingleFile
       NOT enabled on Mac because the .app bundle structure requires loose
       files at known paths — bundle.sh assembles them into Contents/MacOS/. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Default (no RID): Exe, portable for tests + design-time. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Setup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Diagnostics\SuavoAgent.Diagnostics.csproj" />
  </ItemGroup>

</Project>
