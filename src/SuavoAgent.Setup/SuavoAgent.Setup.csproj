<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SuavoSetup</AssemblyName>
    <AssemblyTitle>SuavoAgent Setup</AssemblyTitle>
    <Description>Suavo pharmacy agent installer — signed one-click setup with HIPAA BAA consent.</Description>
    <RootNamespace>SuavoAgent.Setup</RootNamespace>
    <!-- The Suavo mark as the EXE / taskbar / Alt-Tab / UAC-dialog icon (multi-size .ico, 16–256). -->
    <ApplicationIcon>Assets\suavo.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
    <NoWarn>CA1416</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Publish-only properties. `dotnet publish -r win-x64` activates this group
    so the release workflow keeps emitting a self-contained, compressed single-
    file Windows binary. `dotnet build` (no -r) produces a portable assembly,
    which lets the test project reference SuavoAgent.Setup without activating
    the single-file + SelfContained constraints.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SuavoAgent.Setup.Tests" />
  </ItemGroup>

  <!-- Brand assets embedded as Avalonia resources: suavo-logo.png drives the in-app
       logo (title strip + Welcome/Success heroes via avares://); suavo.ico is the
       Window.Icon. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- RFC 8785 canonicalization for vertical-config signature verification (mirrors Diagnostics). -->
    <PackageReference Include="JsonCanonicalizer" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vertical-config signing keys — embedded trust store.
         Resource naming: vertical-config-signing-key-<key_id>.pub.pem -->
    <EmbeddedResource Include="Resources\vertical-config-signing-key-*.pub.pem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SuavoAgent.Diagnostics\SuavoAgent.Diagnostics.csproj" />
  </ItemGroup>

</Project>
