          Link="fixtures\brain-cohort-contract-v3.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\brain-cohort-production-manifest-v1.json"
          Link="fixtures\brain-cohort-production-manifest-v1.json"
